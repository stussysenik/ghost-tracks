# Ghost Tracks — environment manifest
# Copy to `.env` and fill in real values. `npm run doctor` verifies presence.

# --- LLM (Cerebras Gemma 4 31B, OpenAI-compatible) -------------------------
# text→shape, area reasoning, and the vision judge all run through this key.
CEREBRAS_API_KEY=

# --- Mapbox ----------------------------------------------------------------
# Same token, exposed two ways: server-side (Directions/Geocoding) and to the
# browser (map rendering). VITE_ is public by design; keep it URL-restricted.
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# --- Topology --------------------------------------------------------------
# SvelteKit API routes proxy directly to FastAPI.
BACKEND_URL=http://127.0.0.1:8000

# --- Payments (Stripe — the loss function) ----------------------------------
# Export credits are bought via Stripe Checkout and consumed one-per-GPX,
# server-side. The app NEVER holds these; the backend does. Get them from
# https://dashboard.stripe.com/apikeys (test keys start with sk_test_).
STRIPE_SECRET_KEY=
# Signing secret for the /billing/webhook endpoint (whsec_...). Verifies that
# webhook payloads actually come from Stripe before credits are granted.
STRIPE_WEBHOOK_SECRET=
# Optional: price of one export credit in cents (default 200 = $2.00).
# CREDIT_UNIT_CENTS=200

# --- Optional tunables (defaults in code; override only if needed) ----------
# SHAPE_VALIDATION_THRESHOLD=45
# MAX_GENERATION_RETRIES=2

# --- Optional fallback ------------------------------------------------------
# GLM-5.1 on Modal — manual fallback if Cerebras preview is unavailable.
# GLM_MODAL_KEY=
